                "p:k3x9/start": ["Kväll", 1760000000000],
                "p:k3x9/pos": [-2, 1760000000000],
                "p:b/off": [0, 1760000000000],
                "r:2026-01-01": [950.5, 1760000000000],
                "o:target": [450, 1760000000000],
                "o:max": [0, 1760000000000],
                "o:vat": [12.5, 1760000000000],
                "o:carryFlex": [1, 1760000000000],
                "o:punchRound": [15, 1760000000000],
                "p:a/name": ["Förmiddag hemma", 1760000000000]
            }
        },
        {
