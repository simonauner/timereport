    "merge": [
        {
            "name": "the latest change to each key wins",
            "current": {
                "t:2026-10-01/a/start": ["08:00", 100],
                "t:2026-10-01/a/end": ["12:00", 300],
                "x:2026-10-02": [1, 100]
            },
            "incoming": {
                "t:2026-10-01/a/start": ["08:15", 200],
                "t:2026-10-01/a/end": ["11:00", 200],
                "x:2026-10-02": [null, 150],
                "o:target": [480, 50]
            },
            "expected": {
                "merged": {
                    "t:2026-10-01/a/start": ["08:15", 200],
                    "t:2026-10-01/a/end": ["12:00", 300],
                    "x:2026-10-02": [null, 150],
                    "o:target": [480, 50]
                },
                "changed": 3
            }
        },
        {
            "name": "a tie keeps the current value",
            "current": {
                "o:vat": [25, 100]
            },
            "incoming": {
                "o:vat": [6, 100]
            },
            "expected": {
                "merged": {
                    "o:vat": [25, 100]
                },
                "changed": 0
            }
        },
        {
            "name": "a newer stamp with the same value doesn't count as a change",
            "current": {
                "o:vat": [25, 100]
            },
            "incoming": {
                "o:vat": [25, 200]
            },
            "expected": {
                "merged": {
                    "o:vat": [25, 200]
                },
                "changed": 0
            }
        }
    ]
}
